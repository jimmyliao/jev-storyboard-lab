# TypeSafe Jev — shared by both demos as the QC gate
# https://console.typesafe.ai
TYPESAFE_API_KEY=

# --- adk_demo ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- agent_framework_demo ---
# An Azure OpenAI / Azure AI Foundry resource with a structured-output-
# capable deployment (GPT-4o-2024-08-06+ or GPT-5.x). Uses OpenAIChatClient
# against the resource's OpenAI-compatible endpoint (.../openai/v1) with a
# plain API key — no `az login` / Azure AD needed. (agent_framework.foundry
# .FoundryChatClient is a different client that *does* require Azure AD;
# this repo doesn't use it.)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
FOUNDRY_API_KEY=
